{
  "entities": {
    "snippets": {
      "title": "Code Snippet",
      "description": "Represents a code snippet stored in CodeShelf",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique identifier of the snippet"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Snippet title"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Snippet description"
        },
        "language": {
          "type": "string",
          "maxLength": 32,
          "description": "Programming language"
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "description": "Difficulty level"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category tag"
        },
        "tags": {
          "type": "array",
          "description": "List of tags (max 10)"
        },
        "code": {
          "type": "string",
          "maxLength": 50000,
          "description": "Source code text"
        },
        "sampleOutput": {
          "type": "string",
          "maxLength": 10000,
          "description": "Sample output of code execution"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "ISO timestamp of creation"
        },
        "likes": {
          "type": "number",
          "description": "Total like count"
        },
        "views": {
          "type": "number",
          "description": "Total view count"
        },
        "bookmarksCount": {
          "type": "number",
          "description": "Total bookmark count"
        },
        "isCommunitySubmitted": {
          "type": "boolean",
          "description": "Whether submitted by a user"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the author user"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of the author user"
        },
        "author": {
          "type": "object",
          "description": "Author profile details"
        },
        "teamId": {
          "type": "string",
          "maxLength": 128,
          "description": "Team workspace ID"
        },
        "teamName": {
          "type": "string",
          "maxLength": 100,
          "description": "Team workspace name"
        },
        "teamOwnerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner UID of the team workspace"
        },
        "teamOwnerEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner email of the team workspace"
        },
        "uploadedByMember": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the team member who uploaded"
        },
        "isTeamSnippet": {
          "type": "boolean",
          "description": "Whether uploaded under a team workspace"
        }
      },
      "required": ["id", "title", "language", "code", "createdAt", "likes", "views", "bookmarksCount"]
    },
    "teams": {
      "title": "Workspace Team",
      "description": "Represents a collaborative team or workspace created by an authenticated user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Unique Team ID or slug"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Team / Workspace name"
        },
        "pin": {
          "type": "string",
          "maxLength": 32,
          "description": "Access security PIN"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the team creator"
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of the team creator"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the team creator"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp"
        },
        "snippetCount": {
          "type": "number",
          "description": "Count of snippets uploaded under this team"
        },
        "membersCount": {
          "type": "number",
          "description": "Count of active members in the team"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional team description"
        }
      },
      "required": ["id", "name", "pin", "ownerId", "ownerEmail", "createdAt"]
    },
    "users": {
      "title": "User Profile",
      "description": "Represents private user profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "User identifier (UID)"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "maxLength": 128,
          "description": "User email address"
        },
        "avatar": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL"
        },
        "role": {
          "type": "string",
          "maxLength": 32,
          "description": "User role"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/snippets/{snippetId}": {
      "schema": {
        "$ref": "snippets"
      },
      "description": "Public repository of code snippets searchable and viewable by everyone"
    },
    "/teams/{teamId}": {
      "schema": {
        "$ref": "teams"
      },
      "description": "Workspace teams allowing guest members to submit unlimited snippets via team ID and PIN"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "users"
      },
      "description": "Private profile information for an authenticated user"
    }
  }
}
